{
  "name": "routemaster",
  "version": "0.0.0",
  "private": true,
  "description": "Web app for service companies that builds daily routes.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch --watch-path=src --watch-path=public --watch-preserve-output --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env --test",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "seed": "node --env-file=.env scripts/seed-users.js",
    "link:create": "node --env-file=.env scripts/create-link.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "pg": "^8.23.1"
  }
}
