# Names and placeholders only. Copy to .env locally and never commit .env.
# The test-database guard reads DATABASE_URL and TEST_DATABASE_URL.
# Names are from docs/adr/0010.

# Postgres connection string (Supabase session pooler in production). Add ?sslmode=... for TLS; see the runbook.
DATABASE_URL=postgres://user:password@localhost:5432/routemaster

# Signs the session cookie. In production it must be 32+ characters and not a placeholder.
SESSION_SECRET=change-me

# development or production
NODE_ENV=development

# Port the server binds. Render sets this.
PORT=3000

# Throwaway database for tests. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/routemaster_test

# Password given to the seeded test accounts by `pnpm seed`. Never commit the real value.
SEED_PASSWORD=change-me

# Optional. Looks up addresses with Google first; without it only free OpenStreetMap lookups are used.
GOOGLE_MAPS_API_KEY=

# Optional. A state such as ID, added to each address before a lookup.
SERVICE_STATE=

# Optional. The default starting address on the Route Builder page.
ROUTE_START_ADDRESS=
