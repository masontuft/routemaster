# Names and placeholders only. Copy to .env locally and never commit .env.
# Nothing reads these yet; they are the names decided in docs/adr/0010.

# Postgres connection string (Supabase session pooler in production)
DATABASE_URL=postgres://user:password@localhost:5432/routemaster

# Signs the session cookie. Use a long random value.
SESSION_SECRET=change-me

# development or production
NODE_ENV=development

# Port the server binds. Render sets this.
PORT=3000

# Throwaway database for tests. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/routemaster_test
