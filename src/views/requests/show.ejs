<%- include("../partials/head") %>
<h1>Request <%= request.id %></h1>
<dl>
    <dt>Service</dt><dd><%= request.service_type %></dd>
    <dt>Property</dt><dd><%= formatAddress(request.street, request.city) %></dd>
    <dt>Preferred Date</dt><dd><%= request.preferred_date.toISOString().slice(0, 10) %></dd>
    <dt>Status</dt><dd><%= request.status %><%= request.tentative ? " (penciled in, not confirmed)" : "" %></dd>
    <% if (request.notes) { %><dt>Notes</dt><dd><%= request.notes %></dd><% } %>
</dl>
<% if (request.status === "Requested") { %>
    <p><a href="/requests/<%= request.id %>/edit">Change Date or Notes</a></p>
    <form method="post" action="/requests/<%= request.id %>/cancel">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Cancel Request</button>
    </form>
<% } %>
<% if (request.tentative && request.status === "Scheduled") { %>
    <h2>Please Confirm Your Day</h2>
    <p>We penciled you in for <%= request.preferred_date.toISOString().slice(0, 10) %>. Please tell us if that day works.</p>
    <form method="post" action="/requests/<%= request.id %>/confirm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Confirm This Day</button>
    </form>
    <p><a href="/requests/<%= request.id %>/edit">Choose a Different Day</a></p>
    <form method="post" action="/requests/<%= request.id %>/cancel">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">I Do Not Need This Service</button>
    </form>
<% } %>
<% if (request.status === "Completed") { %>
    <% if (review) { %>
        <h2>Your Review</h2>
        <p><%= review.rating %> of 5<%= review.hidden ? " (hidden by staff)" : "" %></p>
        <% if (review.body) { %><p><%= review.body %></p><% } %>
        <p><a href="/requests/<%= request.id %>/review">Edit Review</a></p>
        <form method="post" action="/requests/<%= request.id %>/review/delete">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit">Delete Review</button>
        </form>
    <% } else { %>
        <p><a href="/requests/<%= request.id %>/review">Leave a Review</a></p>
    <% } %>
<% } %>
<h2>Status History</h2>
<ol>
    <% history.forEach((entry) => { %>
        <li><%= entry.status %> on <%= entry.changed_at.toISOString().slice(0, 10) %><%= entry.note ? " - " + entry.note : "" %></li>
    <% }); %>
</ol>
<p><a href="/requests">Back to My Requests</a></p>
<%- include("../partials/foot") %>
