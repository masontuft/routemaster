<%- include("../partials/head") %>
<h1>New Request</h1>
<%- include("../partials/errors") %>
<% if (properties.length === 0) { %>
    <p>Add a property before requesting service. <a href="/properties/new">Add Property</a></p>
<% } else { %>
    <form method="post" action="/requests">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="serviceTypeId">Service</label>
        <select id="serviceTypeId" name="serviceTypeId" required>
            <% types.forEach((type) => { %>
                <option value="<%= type.id %>" <%= Number(values.serviceTypeId) === type.id ? "selected" : "" %>><%= type.name %></option>
            <% }); %>
        </select>
        <label for="propertyId">Property</label>
        <select id="propertyId" name="propertyId" required>
            <% properties.forEach((property) => { %>
                <option value="<%= property.id %>" <%= Number(values.propertyId) === property.id ? "selected" : "" %>><%= property.street %>, <%= property.city %></option>
            <% }); %>
        </select>
        <label for="preferredDate">Preferred Date</label>
        <input id="preferredDate" name="preferredDate" type="date" min="<%= today %>" value="<%= values.preferredDate || "" %>" required>
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" maxlength="500"><%= values.notes || "" %></textarea>
        <button type="submit">Submit Request</button>
    </form>
<% } %>
<%- include("../partials/foot") %>
