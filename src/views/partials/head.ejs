<!DOCTYPE html>
<html lang="en" data-palette="enterprise">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= title %> | Routemaster</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="<%= locals.pageStyle || "app" %>">
    <a class="skip-link" href="#main">Skip to Main Content</a>
    <header>
        <a class="brand" href="/">Routemaster</a>
        <nav aria-label="Main">
            <a href="/services">Services</a>
            <a href="/reviews">Reviews</a>
            <a href="/contact">Contact</a>
            <% if (locals.user) { %>
                <% if (locals.user.role === "customer") { %><a href="/requests">My Requests</a><% } %>
                <% if (["owner", "dispatcher"].includes(locals.user.role)) { %><a href="/staff">Staff</a><% } %>
                <% if (locals.user.role === "owner") { %><a href="/admin/users">Users</a><a href="/admin/service-types">Manage Services</a><% } %>
                <span><%= locals.user.displayName %></span>
                <form method="post" action="/logout">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <button type="submit">Log Out</button>
                </form>
            <% } else { %>
                <a href="/login">Log In</a>
                <a href="/register">Create Account</a>
            <% } %>
        </nav>
    </header>
    <main id="main">
