<!DOCTYPE html>
<html lang="en" data-palette="enterprise">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= title %> | Routemaster</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="<%= locals.pageStyle || "app" %>">
    <a class="skip-link" href="#main">Skip to Main Content</a>
    <header>
        <a class="brand" href="/">Routemaster</a>
        <%
            // A link is current on its own page and on pages beneath it, so Staff stays marked inside /staff/day-board.
            const here = locals.currentPath || "";
            const cur = (path) => (here === path || here.startsWith(path + "/") ? ' aria-current="page"' : "");
            const isOwner = locals.user && locals.user.role === "owner";
            const adminLinks = [
                ["/admin/users", "Users"],
                ["/admin/service-types", "Manage Services"],
                ["/admin/import", "Import"],
                ["/admin/settings", "Settings"],
                ["/admin/clear", "Clear Customers"],
            ];
            const inAdmin = adminLinks.some(([path]) => cur(path));
        %>
        <nav aria-label="Main">
            <a href="/services"<%- cur("/services") %>>Services</a>
            <a href="/reviews"<%- cur("/reviews") %>>Reviews</a>
            <a href="/contact"<%- cur("/contact") %>>Contact</a>
            <% if (locals.user) { %>
                <% if (locals.user.role === "customer") { %><a href="/requests"<%- cur("/requests") %>>My Requests</a><% } %>
                <% if (["owner", "dispatcher"].includes(locals.user.role)) { %><a href="/staff"<%- cur("/staff") %>>Staff</a><% } %>
                <% if (isOwner) { %>
                    <details class="menu">
                        <summary<%- inAdmin ? ' aria-current="page"' : "" %>>Admin</summary>
                        <ul>
                            <% adminLinks.forEach(([path, label]) => { %><li><a href="<%= path %>"<%- cur(path) %>><%= label %></a></li><% }) %>
                        </ul>
                    </details>
                <% } %>
                <details class="menu account">
                    <summary><%= locals.user.displayName %></summary>
                    <ul>
                        <li>
                            <form method="post" action="/logout">
                                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                                <button type="submit">Log Out</button>
                            </form>
                        </li>
                    </ul>
                </details>
            <% } else { %>
                <a href="/login"<%- cur("/login") %>>Log In</a>
                <a href="/register"<%- cur("/register") %>>Create Account</a>
            <% } %>
        </nav>
    </header>
    <main id="main">
