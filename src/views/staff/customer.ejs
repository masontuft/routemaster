<%- include("../partials/head") %>
<h1><%= customer.name %></h1>
<%- include("../partials/errors") %>
<p><%= customer.phone ?? "" %> <%= customer.email ?? "" %> <a href="/staff/customers/<%= customer.id %>/edit">Edit Customer</a></p>
<h2>Properties</h2>
<ul>
    <% properties.forEach((property) => { %>
        <li>
            <%= formatAddress(property.street, property.city) %><%= property.city ? "" : " (needs a city)" %>
            <a href="/staff/properties/<%= property.id %>/edit">Edit</a>
        </li>
    <% }); %>
</ul>
<h3>Add a Property</h3>
<form method="post" action="/staff/customers/<%= customer.id %>/properties">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="street">Street Address</label>
    <input id="street" name="street" value="<%= propertyValues.street || "" %>" required maxlength="120">
    <label for="city">City</label>
    <input id="city" name="city" value="<%= propertyValues.city || "" %>" required maxlength="80">
    <label for="zip">ZIP Code</label>
    <input id="zip" name="zip" value="<%= propertyValues.zip || "" %>" maxlength="10">
    <button type="submit">Add Property</button>
</form>
<h2>Requests</h2>
<ul>
    <% requests.forEach((item) => { %>
        <li><a href="/staff/requests/<%= item.id %>"><%= item.service_type %></a> - <%= item.status %></li>
    <% }); %>
</ul>
<h2>Scheduling Links</h2>
<% if (newLink) { %>
    <p>New link. Copy it now: it is shown only once.</p>
    <p><input type="text" readonly value="<%= newLink %>" size="70"></p>
<% } %>
<form method="post" action="/staff/customers/<%= customer.id %>/links">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit">Create Link</button>
</form>
<ul>
    <% links.forEach((link) => { %>
        <li>
            <%= link.state %>, expires <%= link.expires_at.toISOString().slice(0, 10) %>
            <% if (link.state === "Active") { %>
                <form method="post" action="/staff/customers/<%= customer.id %>/links/<%= link.id %>/revoke">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Revoke</button>
                </form>
            <% } %>
        </li>
    <% }); %>
</ul>
<%- include("../partials/foot") %>
