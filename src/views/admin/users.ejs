<%- include("../partials/head") %>
<h1>Users</h1>
<% if (notice) { %><p role="status"><%= notice %></p><% } %>
<%- include("../partials/errors") %>
<p><a href="/admin/users/new">Add Staff User</a></p>
<p><a href="/admin/users/invite">Invite Staff by Email</a></p>
<div class="table-scroll" role="region" aria-label="Users" tabindex="0">
<table>
    <thead><tr><th>Email</th><th>Role</th><th>Joined</th><th></th></tr></thead>
    <tbody>
        <% users.forEach((row) => { %>
            <tr>
                <td><%= row.email ?? "(signs in by link)" %></td>
                <td><%= row.role %></td>
                <td><%= row.created %></td>
                <td>
                    <% if (row.email && row.id !== locals.user.id) { %>
                        <% if (row.needs_invite) { %>
                            <form method="post" action="/admin/users/<%= row.id %>/invite">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit">Resend Invitation</button>
                            </form>
                            <span>Invitation pending</span>
                        <% } %>
                        <form method="post" action="/admin/users/<%= row.id %>/role">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <select name="role" aria-label="Role for <%= row.email %>">
                                <% roles.forEach((name) => { %>
                                    <option value="<%= name %>"<%= name === row.role ? " selected" : "" %>><%= name %></option>
                                <% }); %>
                            </select>
                            <button type="submit">Change Role</button>
                        </form>
                        <form method="post" action="/admin/users/<%= row.id %>/email">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input name="email" type="email" required maxlength="254" placeholder="New email" aria-label="New email for <%= row.email %>">
                            <button type="submit">Change Email</button>
                        </form>
                    <% } %>
                </td>
            </tr>
        <% }); %>
    </tbody>
</table>
</div>
<%- include("../partials/foot") %>
