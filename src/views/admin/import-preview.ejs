<%- include("../partials/head") %>
<h1>Import Preview</h1>
<%- include("../partials/errors") %>
<p><strong>Nothing has been saved yet.</strong> This shows what an import of <strong><%= sheetName %></strong> would do.</p>

<h2>What Confirming Would Do</h2>
<ul>
    <li><%= plan.customersToCreate %> new customers and <%= plan.propertiesToCreate %> new properties</li>
    <li><%= plan.jobsToCreate %> jobs, each dated by its own day and marked <%= optionValues.statusName %></li>
    <li><%= plan.rowsWithoutDate %> rows with no date add a customer and property but no job</li>
    <li><%= plan.duplicateJobsInSheet %> repeated rows for the same property and day are counted once</li>
    <li>Skipped: <%= skipped.blocked %> with no name or street, <%= skipped.flagged %> on another customer's street,
        <%= skipped.missing_city %> with no city</li>
    <li>A job already on file for the same property, service and day is not added again</li>
</ul>
<% if (canConfirm) { %>
    <form method="post" action="/admin/import/confirm">
        <%- include("import-hidden") %>
        <input type="hidden" name="planHash" value="<%= planHash %>">
        <button type="submit">Confirm Import</button>
    </form>
<% } else { %>
    <p>There is nothing new to import.</p>
<% } %>

<h2>Summary</h2>
<ul>
    <li><%= summary.total %> rows read, <%= skippedEmpty %> empty rows skipped</li>
    <li><%= summary.blocked %> cannot be imported (no name or no street)</li>
    <li><%= summary.flagged %> need a decision (the street belongs to a different customer)</li>
    <li><%= summary.new_property %> are known customers at a new street</li>
    <li><%= summary.new %> are new customers</li>
    <li><%= summary.existing %> match a customer and street already on file</li>
    <li><%= summary.properties %> distinct streets, <%= summary.warnings %> rows with warnings</li>
</ul>

<% const labels = {
    blocked: "Cannot Import",
    flagged: "Needs a Decision",
    new_property: "Known Customer, New Street",
    new: "New Customer",
    existing: "Already on File",
}; %>
<% groups.forEach((group) => { %>
    <% if (group.total > 0) { %>
        <h2><%= labels[group.kind] %> (<%= group.total %>)</h2>
        <% if (group.total > group.shown.length) { %>
            <p>Showing the first <%= group.shown.length %> of <%= group.total %>.</p>
        <% } %>
        <div class="table-scroll" role="region" aria-label="<%= labels[group.kind] %>" tabindex="0">
        <table>
            <thead><tr>
                <th>Row</th><th>Name</th><th>Phone</th><th>Street</th><th>City</th><th>Date</th><th>Amount</th><th>Area</th><th>Notes</th>
            </tr></thead>
            <tbody>
                <% group.shown.forEach((row) => { %>
                    <tr>
                        <td><%= row.rowNumber %></td>
                        <td><%= row.name %></td>
                        <td><%= row.phone %></td>
                        <td><%= row.street %></td>
                        <td><%= row.city %></td>
                        <td><%= row.date %></td>
                        <td><%= row.amountCents === null ? "" : formatCents(row.amountCents) %></td>
                        <td><%= row.area %></td>
                        <td><%= row.issues.join(" ") %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
        </div>
    <% } %>
<% }); %>

<form method="post" action="/admin/import/mapping">
    <%- include("import-hidden") %>
    <button type="submit">Change Mapping</button>
</form>
<p><a href="/admin/import">Start Over</a></p>
<%- include("../partials/foot") %>
