<%- include("../partials/head") %>
<h1>Import Spreadsheet</h1>
<%- include("../partials/errors") %>
<p>For the best results, give each row a customer name, a street address, a city and a ZIP code. The name and street
    are required. A row with no city is still imported, but its property is saved without one.</p>
<form method="post" action="/admin/import">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="link">Public Google Sheet Link</label>
    <input id="link" name="link" type="url" required maxlength="2048" autocomplete="off">
    <button type="submit">Read Spreadsheet</button>
</form>
<% if (sheets) { %>
    <h2>Sheets Found</h2>
    <div class="table-scroll" role="region" aria-label="Sheets found" tabindex="0">
    <table>
        <thead><tr><th>Sheet</th><th>Rows</th><th>Columns</th><th></th></tr></thead>
        <tbody>
            <% sheets.forEach((sheet) => { %>
                <tr>
                    <td><%= sheet.name %></td><td><%= sheet.rowCount %></td><td><%= sheet.columnCount %></td>
                    <td>
                        <form method="post" action="/admin/import/mapping">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="sheetId" value="<%= sheetId %>">
                            <input type="hidden" name="sheet" value="<%= sheet.name %>">
                            <button type="submit">Choose</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
    </div>
<% } %>
<%- include("../partials/foot") %>
