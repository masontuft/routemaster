<%- include("partials/head") %>
<h1>Reset Password</h1>
<% if (invalid) { %>
    <p role="status">This password reset link is invalid or has expired. Request another one to continue.</p>
    <p><a href="/forgot-password">Request a new reset link</a></p>
<% } else { %>
    <%- include("partials/errors") %>
    <form method="post" action="/reset-password/<%= encodeURIComponent(token) %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="password">New Password</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password">
        <label for="confirm">Confirm New Password</label>
        <input id="confirm" name="confirm" type="password" required minlength="8" autocomplete="new-password">
        <button type="submit">Reset Password</button>
    </form>
<% } %>
<%- include("partials/foot") %>
